{{ 'newsletter-popup.css' | asset_url | stylesheet_tag }}
<script src="{{ 'newsletter-popup.js' | asset_url }}" defer="defer"></script>

{%- unless customer -%}
  {%- if section.settings.enable -%}
    {%- style -%}
      #NewsletterPopup-{{ section.id }} {
        --popup-corner-radius: {{ section.settings.corner_radius }}px;
      }
    {%- endstyle -%}

    <newsletter-popup
      data-storage-key="newsletter-popup:v1"
      data-scroll-percentage="{{ section.settings.scroll_percentage }}"
      data-redisplay-days="{{ section.settings.redisplay_days }}"
      data-delay="{{ section.settings.delay }}"
    >
      <div
        class="newsletter-popup"
        id="NewsletterPopup-{{ section.id }}"
        hidden
      >
        <div class="newsletter-popup__overlay" data-popup-close></div>

        <div
          class="newsletter-popup__content color-{{ section.settings.color_scheme }} gradient{% if section.settings.image != blank %} newsletter-popup__content--with-media{% endif %}"
          role="dialog"
          aria-modal="true"
          aria-labelledby="NewsletterPopupHeading-{{ section.id }}"
        >
          <button
            type="button"
            class="newsletter-popup__close"
            data-popup-close
            aria-label="{{ 'accessibility.close' | t }}"
          >
            <span class="svg-wrapper icon">
              {{- 'icon-close.svg' | inline_asset_content -}}
            </span>
          </button>

          {%- if section.settings.image != blank -%}
            <div class="newsletter-popup__media-wrapper">
              {{
                section.settings.image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  class: 'newsletter-popup__media',
                  widths: '400, 600, 800, 1200',
                  sizes: '(min-width: 750px) 24rem, 100vw'
              }}
            </div>
          {%- endif -%}

          <div class="newsletter-popup__inner">
            {%- if section.settings.badge != blank -%}
              <p class="newsletter-popup__badge">{{ section.settings.badge | escape }}</p>
            {%- endif -%}

            <h2 class="newsletter-popup__heading {{ section.settings.heading_size }}" id="NewsletterPopupHeading-{{ section.id }}">
              {{ section.settings.heading }}
            </h2>

            {%- if section.settings.text != blank -%}
              <div class="newsletter-popup__text rte">{{ section.settings.text }}</div>
            {%- endif -%}

            {%- liquid
              assign placeholder_text = section.settings.placeholder
              if placeholder_text == blank
                assign placeholder_text = 'newsletter.label' | t
              endif
            -%}

            {%- form 'customer', class: 'newsletter-popup__form' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">

              <div class="newsletter-popup__fields" data-popup-fields {% if form.posted_successfully? %}hidden{% endif %}>
                <div class="newsletter-popup__field">
                  <label class="visually-hidden" for="NewsletterPopupEmail-{{ section.id }}">
                    {{ 'newsletter.label' | t }}
                  </label>
                  <input
                    id="NewsletterPopupEmail-{{ section.id }}"
                    type="email"
                    name="contact[email]"
                    class="newsletter-popup__input"
                    value="{{ form.email }}"
                    aria-required="true"
                    autocorrect="off"
                    autocapitalize="off"
                    autocomplete="email"
                    {% if form.errors %}
                      aria-invalid="true"
                      aria-describedby="NewsletterPopupError-{{ section.id }}"
                    {% endif %}
                    placeholder="{{ placeholder_text | escape }}"
                    required
                  >
                </div>

                <button
                  type="submit"
                  class="newsletter-popup__submit"
                  name="commit"
                >
                  <span>{{ section.settings.button_label | escape }}</span>
                  <span class="newsletter-popup__button-icon" aria-hidden="true">
                    <i class="fa-regular fa-face-cowboy-hat"></i>
                  </span>
                  <span class="newsletter-popup__spinner" aria-hidden="true"></span>
                </button>

                {%- if form.errors -%}
                  <small class="newsletter-popup__error form__message" data-popup-error id="NewsletterPopupError-{{ section.id }}">
                    <span class="svg-wrapper">
                      {{- 'icon-error.svg' | inline_asset_content -}}
                    </span>
                    {{- form.errors.translated_fields.email | capitalize }}
                    {{ form.errors.messages.email -}}
                  </small>
                {%- endif -%}

                {%- if section.settings.disclaimer != blank -%}
                  <p class="newsletter-popup__disclaimer">{{ section.settings.disclaimer }}</p>
                {%- endif -%}
              </div>

              <h3
                class="newsletter-popup__message--success form__message"
                data-popup-success
                tabindex="-1"
                {% unless form.posted_successfully? %}hidden{% endunless %}
              >
                <span class="svg-wrapper">
                  {{- 'icon-success.svg' | inline_asset_content -}}
                </span>
                {{ section.settings.success_text }}
              </h3>
            {%- endform -%}
          </div>
        </div>
      </div>
    </newsletter-popup>
  {%- endif -%}
{%- endunless -%}

{% schema %}
{
  "name": "Newsletter popup",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable",
      "label": "Enable popup",
      "default": true
    },
    {
      "type": "paragraph",
      "content": "Collects emails with the \"newsletter\" tag, so it triggers the same welcome automation as your footer signup."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image (optional)",
      "info": "Shown beside the copy on desktop, above it on mobile. A vertical or square crop works best."
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Eyebrow label (optional)",
      "default": "Limited drops"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Get 10% off your first order"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Join the list and we'll send your code right over. You'll also be first to know about new drops — we make super limited quantities.</p>"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Email field placeholder",
      "default": "you@email.com"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Submit button label",
      "default": "Get my 10% off"
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "Success message",
      "default": "Thanks! Check your inbox for your 10% off code."
    },
    {
      "type": "text",
      "id": "disclaimer",
      "label": "Small print (optional)",
      "default": "No spam, just drops. Unsubscribe anytime."
    },
    {
      "type": "header",
      "content": "Display rules"
    },
    {
      "type": "range",
      "id": "scroll_percentage",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Show after scrolling",
      "default": 50
    },
    {
      "type": "range",
      "id": "delay",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "s",
      "label": "Minimum time on page before showing",
      "default": 3
    },
    {
      "type": "range",
      "id": "redisplay_days",
      "min": 0,
      "max": 90,
      "step": 1,
      "unit": "d",
      "label": "Show again after dismissal (days)",
      "info": "Set to 0 to only ever show once per visitor. Subscribers never see it again.",
      "default": 30
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Corner radius",
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "Newsletter popup"
    }
  ]
}
{% endschema %}
