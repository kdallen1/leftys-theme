{% comment %}
  Renders cart notification

  Accepts:
  - color_scheme: {String} sets the color scheme of the notification (optional)
  - desktop_menu_type: {String} passes the desktop menu type which allows us to use the right css class (optional)

  Usage:
  {% render 'cart-notification' %}
{% endcomment %}

<cart-notification>
  <div class="cart-notification-wrapper{% if desktop_menu_type != 'drawer' %} page-width{% endif %}">
    <div
      id="cart-notification"
      class="cart-notification focus-inset{% if color_scheme %} color-{{ color_scheme }} gradient{% endif %}"
      aria-modal="true"
      aria-label="{{ 'general.cart.item_added' | t }}"
      role="dialog"
      tabindex="-1"
    >
      <div class="cart-notification__header">
        <h2 class="cart-notification__heading caption-large text-body">
          {{- 'icon-checkmark.svg' | inline_asset_content -}}
          {{ 'general.cart.item_added' | t }}
        </h2>
        <button
          type="button"
          class="cart-notification__close modal__close-button link link--text focus-inset"
          aria-label="{{ 'accessibility.close' | t }}"
        >
          <span class="svg-wrapper">
            {{- 'icon-close.svg' | inline_asset_content -}}
          </span>
        </button>
      </div>
      <div id="cart-notification-product" class="cart-notification-product"></div>

      {%- comment -%}
        Filled by sections/cart-notification-promotion.liquid on every cart
        update. Empty on first paint, the same way #cart-notification-product is.
      {%- endcomment -%}
      <div id="cart-notification-promotion"></div>

      <div class="cart-notification__links">
        <a
          href="{{ routes.cart_url }}"
          id="cart-notification-button"
          class="button button--secondary button--full-width"
        >
          {{- 'general.cart.view_empty_cart' | t -}}
        </a>
        <form action="{{ routes.cart_url }}" method="post" id="cart-notification-form">
          <button class="button button--primary button--full-width button--gradient" name="checkout">
            {{ 'sections.cart.checkout' | t }}
          </button>
        </form>
        <button type="button" class="link button-label">{{ 'general.continue_shopping' | t }}</button>
      </div>
    </div>
  </div>
</cart-notification>
{% style %}
  .cart-notification {
    display: none;
  }

  .cart-notification__quantity {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 1rem;
  }

  .cart-notification__quantity-label {
    font-size: 1.3rem;
  }

  .cart-notification__quantity-selector {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
  }

  .cart-notification__quantity-button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.2rem;
    height: 3.2rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background-color: rgba(var(--color-foreground), 0.05);
    cursor: pointer;
    font-size: 1.7rem;
    line-height: 1;
    color: rgb(var(--color-foreground));
    transition: background-color var(--duration-short) ease;
  }

  .cart-notification__quantity-button:hover {
    background-color: rgba(var(--color-foreground), 0.12);
  }

  .cart-notification__quantity-input {
    width: 3.4rem;
    height: 3.2rem;
    text-align: center;
    border: 0;
    background: transparent;
    font-size: 1.5rem;
    color: rgb(var(--color-foreground));
    -moz-appearance: textfield;
  }

  .cart-notification__quantity-input::-webkit-outer-spin-button,
  .cart-notification__quantity-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .cart-notification-product.is-loading {
    opacity: 0.5;
    pointer-events: none;
  }

  /* Moved off the element's style attribute, which the section render replaced. */
  .shirt-promotion {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 1.2rem 1.4rem;
    margin: 1.2rem 0;
    border-radius: 10px;
    border: 1px solid;
    border-left-width: 5px;
    /* The section is re-rendered on every add to cart, so this replays each time. */
    animation: shirt-promotion-pop 0.45s cubic-bezier(0.2, 1.4, 0.4, 1) both;
  }

  .shirt-promotion__link {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    width: 100%;
    color: inherit;
    text-decoration: none;
  }

  .shirt-promotion__icon {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.4rem;
    height: 3.4rem;
    border-radius: 50%;
    font-size: 1.7rem;
    line-height: 1;
  }

  /* The Font Awesome kit swaps the <i> for an <svg>, so size both. */
  .shirt-promotion__icon svg,
  .shirt-promotion__icon i {
    width: 1em;
    height: 1em;
    font-size: inherit;
  }

  .shirt-promotion__text {
    flex: 1 1 auto;
  }

  .shirt-promotion__text strong {
    font-size: 1.5rem;
    letter-spacing: 0.02em;
    line-height: 1.3;
  }

  /* "Add one more shirt and save $15" — an offer still on the table. */
  .shirt-promotion--offer {
    background: linear-gradient(135deg, #fff7e0, #ffe9b3);
    border-color: rgba(197, 132, 0, 0.28);
    border-left-color: #e0a400;
    box-shadow: 0 2px 10px rgba(197, 132, 0, 0.16);
  }

  .shirt-promotion--offer .shirt-promotion__icon {
    background-color: #e0a400;
    color: #fff;
    box-shadow: 0 0 0 0 rgba(224, 164, 0, 0.55);
    animation: shirt-promotion-nudge 2s ease-out 0.45s infinite;
  }

  .shirt-promotion--offer .shirt-promotion__text strong {
    color: #6b4b00;
    text-decoration: underline;
    text-decoration-color: rgba(107, 75, 0, 0.35);
    text-underline-offset: 0.2em;
  }

  .shirt-promotion--offer .shirt-promotion__link:hover .shirt-promotion__text strong,
  .shirt-promotion--offer .shirt-promotion__link:focus-visible .shirt-promotion__text strong {
    text-decoration-color: currentcolor;
  }

  .shirt-promotion__arrow {
    flex: 0 0 auto;
    display: inline-block;
    font-size: 1.6rem;
    font-weight: 700;
    color: #6b4b00;
    transition: transform 0.2s ease;
  }

  .shirt-promotion__link:hover .shirt-promotion__arrow,
  .shirt-promotion__link:focus-visible .shirt-promotion__arrow {
    transform: translateX(0.25em);
  }

  /* Two or more shirts — the $15 is already theirs. */
  .shirt-promotion--earned {
    background: linear-gradient(135deg, #eafbf0, #cdf3dc);
    border-color: rgba(26, 127, 55, 0.28);
    border-left-color: #1a7f37;
    box-shadow: 0 2px 10px rgba(26, 127, 55, 0.16);
  }

  .shirt-promotion--earned .shirt-promotion__icon {
    background-color: #1a7f37;
    color: #fff;
    animation: shirt-promotion-tip 0.7s ease-out 0.35s both;
  }

  .shirt-promotion--earned .shirt-promotion__text strong {
    color: #10592a;
  }

  @keyframes shirt-promotion-pop {
    from {
      opacity: 0;
      transform: translateY(0.6rem) scale(0.97);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes shirt-promotion-nudge {
    0%,
    70%,
    100% {
      transform: none;
      box-shadow: 0 0 0 0 rgba(224, 164, 0, 0.55);
    }
    35% {
      transform: scale(1.08);
      box-shadow: 0 0 0 0.8rem rgba(224, 164, 0, 0);
    }
  }

  @keyframes shirt-promotion-tip {
    0% {
      transform: rotate(0deg) scale(1);
    }
    30% {
      transform: rotate(-12deg) scale(1.12);
    }
    60% {
      transform: rotate(8deg) scale(1.08);
    }
    100% {
      transform: rotate(0deg) scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .shirt-promotion,
    .shirt-promotion__icon {
      animation: none;
    }
  }
{% endstyle %}
